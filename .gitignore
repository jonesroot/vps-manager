# ------------------------------------------------------------------------------
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Hatchling & Flit build caches
.hatch/

# Pip installation logs
pip-log.txt
pip-delete-this-directory.txt

