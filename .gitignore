# ==============================================================================
# VPS MANAGER PRO - PRODUCTION .GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL SECURITY: SECRETS, CREDENTIALS & LOCAL CONFIG
# ------------------------------------------------------------------------------
# Never commit server configurations containing IPs, ports, or encrypted secrets
servers.json
*.servers.json
.servers.lock
*.lock

# Vault master encryption keys and private keys
.vault.key
*.key
*.pem
*.id_rsa
*.id_ed25519
*.id_ecdsa
*.id_dsa
id_*
!*.pub

# Local environment variables and tokens
.env
.env.*
!.env.example

# Temporary database backups and swap files
*.bak
*.backup
*.tmp
.servers.json.*.tmp

# ------------------------------------------------------------------------------
# 2. PYTHON RUNTIME & BYTECODE
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# C extensions & native builds
*.c
*.html
*.ffi

# ------------------------------------------------------------------------------
# 3. VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------------------
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

